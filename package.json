{
  "name": "openchamber-podman",
  "version": "0.1.1",
  "description": "Podman extension for OpenChamber — manage containers, view logs, inspect resources, and exec commands.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bundle": "openchamber-guest-bundle panel/main.ts panel/main.js",
    "type-check": "tsc --noEmit",
    "pack": "bun run bundle && rm -f podman-extension.zip && zip -r podman-extension.zip package.json icon.svg panel/ agent/ README.md LICENSE",
    "clean": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@openchamber/sdk": "^1.23.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.22.0"
    },
    "contributes": {
      "panel": {
        "id": "podman",
        "name": "Podman",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "agent/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "podman"
          ]
        }
      },
      "attach": false
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
